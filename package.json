{
  "name": "markclip",
  "version": "1.4.0",
  "private": true,
  "description": "Local Chrome extension that clips web pages to Markdown.",
  "type": "commonjs",
  "scripts": {
    "test": "node --test",
    "test:unit": "node --test test/*.test.js",
    "lint": "npm run check:syntax",
    "check": "npm run check:syntax && npm run check:manifest && npm test",
    "check:syntax": "node scripts/check-syntax.js",
    "check:manifest": "node scripts/check-manifest.js",
    "check:security": "node scripts/check-third-party.js && npm audit --audit-level=high",
    "icons:generate": "node scripts/generate-icons.js",
    "store-assets:generate": "node scripts/generate-store-assets.js",
    "ui-review:capture": "node scripts/capture-ui-review.js",
    "package": "node scripts/package-extension.js",
    "release": "npm run check && npm run check:security && npm run package",
    "test:e2e": "node --test test/e2e/*.test.js",
    "test:e2e:chrome": "node --test test/e2e/chrome-cdp-extension.test.js",
    "test:live": "node scripts/live-smoke.js"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "playwright": "^1.62.1"
  }
}
