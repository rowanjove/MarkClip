{
  "name": "markclip",
  "version": "1.5.0",
  "private": true,
  "description": "Local Chrome extension that clips web pages to Markdown.",
  "type": "commonjs",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:unit": "node --test test/*.test.js",
    "lint": "npm run check:syntax && npm run typecheck && eslint --max-warnings=0 \"**/*.js\"",
    "check": "npm run lint && npm run typecheck && npm run check:manifest && npm test",
    "check:syntax": "node scripts/check-syntax.js",
    "check:manifest": "node scripts/check-manifest.js",
    "check:licenses": "node scripts/check-licenses.js",
    "check:modern-manifest": "node scripts/check-modern-build.js",
    "check:safari-route": "node scripts/check-safari-route.js",
    "check:security": "node scripts/check-third-party.js && npm run check:licenses && npm audit --audit-level=high",
    "icons:generate": "node scripts/generate-icons.js",
    "store-assets:generate": "node scripts/generate-store-assets.js",
    "ui-review:capture": "node scripts/capture-ui-review.js",
    "package": "npm run package:modern",
    "package:legacy": "node scripts/package-extension.js",
    "release": "npm run release:verify",
    "test:e2e": "node --test test/e2e/*.test.js",
    "test:e2e:chrome": "node --test test/e2e/chrome-cdp-extension.test.js",
    "test:live": "node scripts/live-smoke.js",
    "dev": "wxt",
    "build": "wxt build -b chrome",
    "build:chrome": "wxt build -b chrome",
    "build:firefox": "wxt build -b firefox",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test:modern": "vitest run",
    "test:e2e:modern": "node scripts/run-modern-e2e.js",
    "package:modern": "node scripts/package-wxt.js",
    "check:full": "npm run check && npm run typecheck && npm run test:modern && npm run build:chrome && npm run build:firefox && npm run check:modern-manifest && npm run check:safari-route && npm run check:security",
    "release:verify": "npm run check:full && node scripts/run-release-e2e.js && npm run package:modern"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.5.0",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.10.0",
    "jsdom": "^26.1.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wxt": "^0.21.4"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "defuddle": "^0.19.3",
    "fflate": "^0.8.3",
    "turndown": "^7.2.4",
    "yaml": "^2.9.0"
  }
}
